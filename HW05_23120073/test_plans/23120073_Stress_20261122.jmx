<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="23120073_Stress_20261122"><stringProp name="TestPlan.comments">Stress test: stepped load 10 -&gt; 25 -&gt; 50 -&gt; 100 -&gt; 200 VU, 2 min per step, reduced think-time. Workflow: admin login -&gt; view product list (GET /api/products) -&gt; import CSV -&gt; refresh product list. SUT: eshop-sut backend :3000, client: frontend-admin.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables"><collectionProp name="Arguments.arguments"><elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(host,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PORT" elementType="Argument"><stringProp name="Argument.name">PORT</stringProp><stringProp name="Argument.value">${__P(port,3000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="BATCH_SIZE" elementType="Argument"><stringProp name="Argument.name">BATCH_SIZE</stringProp><stringProp name="Argument.value">${__P(batch,5)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="IMPORT_PCT" elementType="Argument"><stringProp name="Argument.name">IMPORT_PCT</stringProp><stringProp name="Argument.value">${__P(import_pct,20)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="MAX_RT_MS" elementType="Argument"><stringProp name="Argument.name">MAX_RT_MS</stringProp><stringProp name="Argument.value">${__P(max_rt,5000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="IMPORT