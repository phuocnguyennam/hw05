<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Log product count (end)"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Records how many products exist (GET /api/products is not paginated, so payload grows with imports)
def n = new groovy.json.JsonSlurper().parse(prev.getResponseData()).size()
log.info("HW05: ${prev.getSampleLabel()} product count = ${n}, payload = ${prev.getBodySizeAsLong()} bytes")
